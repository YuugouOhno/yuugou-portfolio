+html.home-active, .home-active body { overflow: visible; background: #0a0a1a; }
+.home-page { color: #eeedf5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; isolation: isolate; }
+.home-page a { color: inherit; text-underline-offset: .3em; }
+.home-page a:hover { color: #d5b9f0; }
+.home-page :focus-visible { outline: 2px solid #d5b9f0; outline-offset: 6px; }
+.home-ocean { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
+.home-ocean canvas { width: 100%; height: 100%; pointer-events: none; }
+.home-header { position: absolute; top: 0; inset-inline: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; padding: 28px 5vw; z-index: 2; }
+.home-header > a { text-decoration: none; font-weight: 600; }
+.home-header nav { margin-left: auto; font-size: 14px; }
+.motion-toggle { background: #0a0a1a; border: 1px solid #70667e; padding: 8px 12px; color: inherit; font: inherit; font-size: 12px; cursor: pointer; }
+.home-hero { position: relative; min-height: 100svh; height: 100svh; display: block; padding: 0; }
+.home-intro { position: absolute; top: 40%; width: 100%; text-align: center; padding: 0 5vw; }
+.home-intro h1 { font-size: clamp(30px, 7.8vw, 112px); line-height: 1.2; overflow-wrap: anywhere; }
+.home-intro p { margin-top: 24px; font-size: 17px; letter-spacing: .18em; }
+.has-fish:not(.fish-paused) .home-intro { top: 66%; }
+.has-fish:not(.fish-paused) .home-intro h1 { font-size: 17px; font-weight: 500; letter-spacing: .08em; }
+.has-fish:not(.fish-paused) .home-intro p { margin-top: 10px; font-size: 14px; }
+.home-scroll { position: absolute; bottom: 7%; left: 5vw; font-size: 14px; }
+.home-scroll span { margin-left: 24px; }
+.home-profile { min-height: 95svh; display: flex; align-items: center; justify-content: center; padding: 100px 8vw; scroll-margin-top: 20px; }
+.home-copy { width: min(100%, 660px); background: #0a0a1a; padding: 48px clamp(20px, 4vw, 56px); }
+.home-label { font-size: 13px; color: #c0accf; margin-bottom: 24px; }
+.home-copy h2 { font-size: clamp(28px, 4vw, 44px); font-weight: 500; margin-bottom: 28px; }
+.home-copy p:not(.home-label) { line-height: 2; margin-top: 20px; font-size: 16px; }
+.home-links { display: flex; align-items: flex-start; flex-direction: column; gap: 22px; margin-top: 40px; font-size: 14px; }
+.home-footer { display: flex; justify-content: space-between; gap: 24px; padding: 32px 5vw; background: #0a0a1a; font-size: 13px; }
+@media (max-width: 699px) {
+  .home-header { gap: 16px; padding-top: 24px; }
+  .motion-toggle { margin-left: auto; }
+  .home-profile { padding: 64px 7vw; }
+  .home-copy { padding: 32px 16px; }
+}
+
+.fish-paused .home-ocean { visibility: hidden; }
